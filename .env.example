# 이 파일을 .env 로 복사한 뒤 값을 채우세요. .env 는 git 에 올리지 않습니다.

# EPO Open Patent Services (developers.epo.org 의 앱에서 발급되는 Consumer Key / Secret)
EPO_OPS_KEY=
EPO_OPS_SECRET=

# OpenAlex API 키 (없어도 동작하지만 공용 한도가 매우 작습니다)
OPENALEX_API_KEY=

# 선택: 모델 지정. 비우면 구성 분해·검색식은 claude CLI 기본 모델, 스크리닝은 haiku
PATSEARCH_MODEL=
PATSEARCH_SCREEN_MODEL=
